# Snowkap CBAM — environment variables
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. See docs/architecture/ARCHITECTURE.md and
# CLAUDE.md for the commands that require each variable.

# Required by: `pnpm test` (integration suites), any code importing
# src/infrastructure/supabase/client.ts or admin-client.ts (both are
# server-only and read these the same way).
# Find these in the Supabase project dashboard under Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — it is used
# server-side only by the regulatory adapter and pipeline scripts, and
# must never be exposed to a browser/client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required by: `pnpm regulatory:verify` (scripts/regulatory/verify-definitive-regulatory-data.py)
# and the Python data-loading/reconciliation scripts under scripts/regulatory/.
# This is the direct Postgres connection password (Project Settings > Database),
# not the service-role API key above. The verify script also needs
# supabase/.temp/pooler-url, which is created by `supabase link` and is
# gitignored.
SUPABASE_DB_PASSWORD=

# Required by: the browser-side Supabase client (src/infrastructure/supabase/browser-client.ts)
# and the SSR session client used in Server Components/Actions/middleware.
# The NEXT_PUBLIC_ prefix means Next.js inlines these into the client
# bundle at build time -- this is intentional and safe. The anon/
# publishable key is designed for browser exposure (unlike
# SUPABASE_SERVICE_ROLE_KEY above): every read/write it performs is
# still subject to Postgres RLS. Find both in the Supabase dashboard
# under Project Settings > API (NEXT_PUBLIC_SUPABASE_URL is the same
# value as SUPABASE_URL above; NEXT_PUBLIC_SUPABASE_ANON_KEY is the
# "publishable" key, not the service_role/secret one).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required by: nothing yet enforces this -- it is read (and preferred,
# unconditionally, whenever set) by getAppOrigin()
# (app/team/actions.ts), which builds the absolute URL embedded in
# team-invitation emails. Left unset, that function falls back to the
# request's own Host/X-Forwarded-Host headers, trusted only when the
# host matches a known local-dev pattern -- safe for `pnpm dev`, but
# this is the durable fix once a real staging/production domain exists
# (see docs/architecture/ENVIRONMENT.md's "APP_URL" section and master
# plan §41, an open owner decision). Set to your deployed origin with
# no trailing slash, e.g. https://app.snowkap.example -- leave unset
# for local dev.
APP_URL=

# Required by: nothing -- these are optional overrides for the local-
# Postgres-backed integration suites (tests/integration/*-isolation.test.ts,
# tests/integration/regulatory-authenticated-read.test.ts) and the perf
# scripts under scripts/perf/. Every one of those files already
# defaults to the fixed values `supabase start` prints for a fresh
# local project (http://127.0.0.1:54321 plus two deterministic demo
# JWTs derived from the public default local JWT_SECRET -- not
# secrets, safe to commit or leave blank). Only set these if your local
# Supabase instance runs somewhere other than the default local port/
# project (a different port, a Dockerized instance, etc.). See
# docs/architecture/ENVIRONMENT.md's "Test-only / CI-only" section.
SUPABASE_LOCAL_URL=
SUPABASE_LOCAL_ANON_KEY=
SUPABASE_LOCAL_SERVICE_ROLE_KEY=
SUPABASE_LOCAL_JWT_SECRET=
