# Snowkap CBAM — environment variables
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. See docs/architecture/ARCHITECTURE.md and
# CLAUDE.md for the commands that require each variable.

# Required by: `pnpm test` (integration suites), any code importing
# src/infrastructure/supabase/client.ts.
# Find these in the Supabase project dashboard under Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — it is used
# server-side only by the regulatory adapter and pipeline scripts, and
# must never be exposed to a browser/client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required by: `pnpm regulatory:verify` (scripts/regulatory/verify-definitive-regulatory-data.py)
# and the Python data-loading/reconciliation scripts under scripts/regulatory/.
# This is the direct Postgres connection password (Project Settings > Database),
# not the service-role API key above. The verify script also needs
# supabase/.temp/pooler-url, which is created by `supabase link` and is
# gitignored.
SUPABASE_DB_PASSWORD=
