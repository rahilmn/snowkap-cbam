    "note": "1.390 tCO2e/t x 2 t. By hand: 1.390 x 2 = 2.780; toFixed() with no argument drops the trailing zero, so the byte-exact DecimalString is \"2.78\". This is the exact shape and value production's SNOWKAP IMP-TEST-001 carries.",
    "input": {
      "net_mass_tonnes": "2",
      "quantity_mwh": null,
      "good_sector": "CEMENT",
      "emission_determination": {
        "method": "DEFAULT",
        "resolution": {
          "emission_unit": "TCO2E_PER_TONNE",
          "values": {
            "total": {
              "status": "AVAILABLE",
              "value": "1.390"
            }
          }
        }
      }
    },
    "expected": {
      "status": "COMPUTED",
      "engine_version": "1.3.0",
      "embedded_emissions_tco2e": "2.78",
      "steps": [
        {
          "step": "LINE_EMBEDDED_EMISSIONS",
          "rule_ref": "RULE-EE-001",
          "formula": "line_embedded_emissions = quantity * resolution.values.total.value",
          "inputs": {
            "quantity": "2",
            "specific_embedded_emissions": "1.390"
          },
          "value": "2.78"
        }
      ]
    }
  },
