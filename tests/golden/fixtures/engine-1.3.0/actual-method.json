  {
    "name": "D1: Annex II iron and steel computes from DIRECT emissions alone",
    "note": "OWNER DECISION D1 (2026-09-03), and the case that motivated it. The owner's own worked example: direct 1.850, indirect 0.045, quantity 10. By hand, direct-only: 1.850 x 10 = 18.500 -> toFixed() drops trailing zeros -> \"18.5\". Article 7(1) sentence 2 (RULE-EE-004): for goods listed in Annex II only direct emissions are taken into account. Before D1 this returned PARAMETER_DATASET_UNAVAILABLE and produced no number at all.",
    "input": {
      "net_mass_tonnes": "10",
      "quantity_mwh": null,
      "good_sector": "IRON_STEEL",
      "emission_determination": {
        "method": "ACTUAL",
        "snapshot": {
          "emission_unit": "tCO2e/t",
          "verification": {
            "status": "VERIFIED"
          },
          "values": {
            "direct_specific": "1.850",
            "indirect_specific": "0.045"
          }
        }
      }
    },
    "expected": {
      "status": "COMPUTED",
      "engine_version": "1.3.0",
      "embedded_emissions_tco2e": "18.5",
      "steps": [
        {
          "step": "ANNEX_II_DIRECT_ONLY",
          "rule_ref": "RULE-EE-004",
          "formula": "specific_emissions = direct_specific",
          "inputs": {
            "good_sector": "IRON_STEEL",
            "direct_specific": "1.850",
            "indirect_specific_excluded": "0.045"
          },
          "value": "1.850"
        },
        {
          "step": "LINE_EMBEDDED_EMISSIONS",
          "rule_ref": "RULE-EE-009",
          "formula": "line_embedded_emissions = quantity * direct_specific",
          "inputs": {
            "quantity": "10",
            "direct_specific": "1.850"
          },
          "value": "18.5"
        }
      ]
    }
  },
  {
